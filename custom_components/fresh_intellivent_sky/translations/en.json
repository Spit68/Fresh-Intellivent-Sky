{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "description": "Select a Fresh Intellivent SKY device."
      },
      "auth_method": {
        "description": "An authentication key is required to change settings. Without a key, the integration can only read values.",
        "menu_options": {
          "auth_fetch": "Fetch key from fan",
          "auth_manual": "Enter key manually",
          "no_auth": "No authentication (read-only)"
        }
      },
      "auth_manual": {
        "description": "Enter the authentication key for {name}.",
        "data": {
          "auth_key": "Authentication key"
        }
      },
      "auth_fetch": {
        "description": "Press and hold the power and Wi-Fi buttons on the fan for 8 seconds until it starts flashing, then select Next."
      },
      "bluetooth_confirm": {
        "description": "Set up {name}?"
      }
    },
    "abort": {
      "no_devices_found": "No Fresh Intellivent SKY devices were found.",
