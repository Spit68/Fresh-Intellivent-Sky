      "cannot_connect": "Could not connect to the fan.",
      "unknown": "Unexpected error."
    },
    "error": {
      "auth_code_only_zero": "The fan returned an authentication code containing only zeros. Check that the fan is in pairing mode.",
      "auth_code_empty": "The fan returned an empty authentication code. Check that the fan is in pairing mode and within Bluetooth range.",
      "invalid_auth_key": "Invalid authentication key."
    }
  },
